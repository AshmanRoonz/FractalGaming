scratch/

# Tauri / Electron build artifacts (if either is added later)
src-tauri/target/
src-tauri/Cargo.lock
out-electron/

# Wrangler local cache (regenerated by tools/deploy_cf.py)
.wrangler/

# Full-res map thumbnail source art (kept locally, not shipped)
LSS/map_thumbs/originals/

# Uncompressed GLB originals (v36.29 compression pass, 129MB / 50 files).
# The rollback source for LSS/**/*.glb and the input to tools/compress_glb —
# kept local, never deployed (it sits outside the LSS/ deploy root).
assets_src/

# Deploy staging mirror (robocopy /MIR target of tools/deploy_cf.py)
../FractalGaming_deploy/

# Per-build snapshots of index-working.html (~4 MB each, one per version bump).
# These are a LOCAL rollback safety net, not something the remote needs: 50 of
# them were 188 MB of tracked content and every build added another, which is a
# large part of how .git reached 2.4 GB and made pushes fail. They are already
# excluded from deploys. Keep making them locally — just don't commit them.
backups/

# (v37.24) Blender ship pipeline intermediates — regenerable in ~1 min from
# assets_base/ships + tools/blender/*.py (see tools/blender/README.md).
# assets_src/ is the float32 Blender export that compress_glb.mjs reads (~25 MB
# per iteration) ; reports/ is renders + JSON from the last run.
assets_src/
tools/blender/reports/
tools/blender/reports_cleanup.log
tools/blender/work/

# Meshy AI (tools/meshy): the API key and unchosen generated candidates never enter git
tools/meshy/.key
assets_base/cockpits/candidates/

# Meshy v2 fleet intermediates (regenerable: python tools/blender/fleet_v2.py)
assets_base/ships_v2/
tools/blender/work_v2/
tools/meshy/__pycache__/

# the owner's original hi-poly ship exports (166 MB ; the v37.41 chain input) - kept out of git for size, see tools/blender/README.md
LSS/ships_original/

# untouched copies of LSS/ships_original before tools/transfer_markers.mjs added the marker nodes
assets_base/ships_original_raw/

# remeshed + rebaked hulls from tools/blender/ship_remesh.py (regenerable, big)
assets_base/ships_clean/

# blender-model-optimizer trial outputs (tools/blender/optimizer_try.py)
assets_base/ships_opt/
