# Cloudflare Pages cache policy (ignored by GitHub Pages, harmless there).
# Game code: always revalidate so a version bump reaches players immediately.
/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

# Heavy media: cached hard for a week. These change rarely; when one does,
# bump the filename or accept up to a week of edge staleness.
/objects/*
  Cache-Control: public, max-age=604800

/ships/*
  Cache-Control: public, max-age=604800

/sounds/*
  Cache-Control: public, max-age=604800

/music/*
  Cache-Control: public, max-age=604800

/frames/*
  Cache-Control: public, max-age=604800

/skybox/*
  Cache-Control: public, max-age=604800

/walls/*
  Cache-Control: public, max-age=604800

/themes/*
  Cache-Control: public, max-age=604800

/rings/*
  Cache-Control: public, max-age=604800

/effects/*
  Cache-Control: public, max-age=604800

/campaign_media/*
  Cache-Control: public, max-age=604800

/map_thumbs/*
  Cache-Control: public, max-age=604800

# (v36.22) GAP FIX. asset-manifest.json lists seven directories and this was the
# only one with no rule — the 40 announcer voice clips (audio/*.mp3 + the audio
# manifest, ~1.2 MB) were falling through to the one-hour catch-all below, so a
# player returning the next day re-downloaded them even though the page-load
# preload had "cached them forever". Now all seven match.
/audio/*
  Cache-Control: public, max-age=604800

# Everything else (docs, labs, small pages): one hour.
/*
  Cache-Control: public, max-age=3600
