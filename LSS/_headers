# Cloudflare Pages cache policy (ignored by GitHub Pages, harmless there).
#
# (v38.60) RULE ORDER MATTERS. Pages applies EVERY matching block and, for a
# header set by more than one block, APPENDS the values — so with the
# catch-all at the bottom every GLB/MP3/PNG went out as
# "Cache-Control: public, max-age=604800, public, max-age=3600" (measured
# live). Browsers happened to take the first value; RFC 9111 calls the field
# invalid and intermediaries may drop it. The catch-all now comes FIRST and
# each specific block starts with `! Cache-Control` (remove what earlier
# blocks set) before stating its own value.

# Everything else (docs, labs, small pages): one hour.
/*
  Cache-Control: public, max-age=3600

# Game code: always revalidate so a version bump reaches players immediately.
/index.html
  ! Cache-Control
  Cache-Control: no-cache

/
  ! Cache-Control
  Cache-Control: no-cache

# (v38.64) The game script. strip.py now emits it as its own file, requested
# as lss.js?v=<LSS_BUILD>: a new build is a NEW url, so this can be cached for
# a year and never revalidated — and index.html shrinks to ~150 KB, so its
# validator-less no-cache costs little. (A JS file also gets V8's code cache,
# which an inline script never did.)
/lss.js
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Art-stamped binaries (every URL carries the _MODEL_CACHE_BUST /
# _FRAME_CACHE_BUST content stamp, so a changed file is a NEW url): cache for
# a year and never revalidate.
/ships/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/objects/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/rings/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/frames/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Heavy media without a content stamp: cached hard for a week. These change
# rarely; when one does, bump the filename or accept up to a week of edge
# staleness.
/sounds/*
  ! Cache-Control
  Cache-Control: public, max-age=604800

/music/*
  ! Cache-Control
  Cache-Control: public, max-age=604800

/skybox/*
  ! Cache-Control
  Cache-Control: public, max-age=604800

/walls/*
  ! Cache-Control
  Cache-Control: public, max-age=604800

/themes/*
  ! Cache-Control
  Cache-Control: public, max-age=604800

/effects/*
  ! Cache-Control
  Cache-Control: public, max-age=604800

/campaign_media/*
  ! Cache-Control
  Cache-Control: public, max-age=604800

/map_thumbs/*
  ! Cache-Control
  Cache-Control: public, max-age=604800

# (v36.22) GAP FIX. asset-manifest.json lists seven directories and this was the
# only one with no rule — the 40 announcer voice clips (audio/*.mp3 + the audio
# manifest, ~1.2 MB) were falling through to the one-hour catch-all, so a
# player returning the next day re-downloaded them even though the page-load
# preload had "cached them forever". Now all seven match.
/audio/*
  ! Cache-Control
  Cache-Control: public, max-age=604800
