# LOCAL DEV ONLY - loaded by `wrangler dev --env-file dev/mock.env` (the `lss-backend-dev` launch
# entry). Every value here is a fake for dev/mock_services.mjs; none of them is a real credential.
# DEV_MOCKS=1 is what lets DEV_DISCORD_API / DEV_PAYPAL_API take effect - production never sets it.
DEV_MOCKS=1
DEV_DISCORD_API=http://localhost:8788/discord
DEV_PAYPAL_API=http://localhost:8788/paypal
PAYPAL_CLIENT_ID=mock-client-id
PAYPAL_CLIENT_SECRET=mock-client-secret
PAYPAL_WEBHOOK_ID=mock-webhook-id
ADMIN_KEY=dev-admin-key
